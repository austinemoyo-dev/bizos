# BizOS Backend — Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to /var/www/bizos/backend/.env on the server
# 2. Fill in every value marked REPLACE_THIS
# 3. Never commit the filled-in .env to git
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (created by setup.sh)
DATABASE_URL=postgresql://bizos_user:REPLACE_THIS@localhost:5432/bizos_db

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_THIS_64_CHAR_RANDOM_STRING

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ENV=production
DEBUG=false

# Your frontend subdomain — no trailing slash
CORS_ORIGINS=https://bizos.YOURDOMAIN.COM
