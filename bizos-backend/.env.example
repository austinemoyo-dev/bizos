# Copy this to .env and fill in real values. NEVER commit .env to git.

# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DATABASE_URL=postgresql://bizos_user:STRONG_PASSWORD_HERE@localhost:5432/bizos_db
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "production" on live server
ENV=development
DEBUG=false

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000
