# BizOS Frontend — Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to bizos-frontend/.env.production  (on your BUILD machine)
# 2. Fill in every value marked REPLACE_THIS
# 3. Never commit the filled-in .env.production to git
#
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.
# Non-public vars (ANTHROPIC_API_KEY, GROQ_API_KEY) are server-only
# and are safe in .env.production — they are never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Same domain as your subdomain — nginx routes /api/v1/* to the backend
NEXT_PUBLIC_API_URL=https://bizos.YOURDOMAIN.COM/api/v1

# Anthropic Claude API key (used by src/app/api/insights/route.ts)
ANTHROPIC_API_KEY=sk-ant-REPLACE_THIS

# Groq API key
GROQ_API_KEY=gsk_REPLACE_THIS
