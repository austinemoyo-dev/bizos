# BizOS Docker — root secrets file
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env  (at the repo root, next to docker-compose.yml)
# 2. Fill in every value marked REPLACE_THIS
# 3. Never commit the filled-in .env to git
#
# docker-compose reads this file automatically.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL — shared between docker-compose and the backend .env override
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Frontend build arg — baked into the JS bundle at image build time
# Must be your real subdomain (no trailing slash)
NEXT_PUBLIC_API_URL=https://bizos.YOURDOMAIN.COM/api/v1

# API keys — injected into the frontend container at runtime (server-only)
ANTHROPIC_API_KEY=sk-ant-REPLACE_THIS
GROQ_API_KEY=gsk_REPLACE_THIS
